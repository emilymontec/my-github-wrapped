# Database (PostgreSQL - managed instance recommended, e.g. Neon/Supabase/RDS)
DATABASE_URL="postgresql://user:password@localhost:5432/github_wrapped"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# GitHub OAuth App (create at https://github.com/settings/developers)
# Scope inicial (login): read:user, user:email, public_repo — repos
# privados NO se piden acá. El scope ampliado "repo" se solicita bajo
# demanda desde /settings (Fase 6, opt-in), vía reautorización
# incremental — no requiere una GitHub OAuth App distinta.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Encryption key used to encrypt GitHubAccount.accessToken / refreshToken at rest
# generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# Job queue (Inngest) - https://www.inngest.com
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Insights Engine (Fase 1) - narración con IA de insights ya calculados,
# servida vía Hugging Face Inference API (https://huggingface.co).
# Opcional: sin HUGGINGFACE_API_KEY, el Insights Engine cae automáticamente
# a plantillas deterministas (lib/insights/templates.ts).
HUGGINGFACE_API_KEY=""
# Opcional: modelo a usar (por defecto mistralai/Mistral-7B-Instruct-v0.3).
# Configurable sin tocar código porque la disponibilidad de modelos en el
# free tier de Hugging Face cambia más seguido que la de otros proveedores.
HUGGINGFACE_MODEL=""

# GitHub Webhooks (Fase 7) - actualizaciones casi en tiempo real vía
# push/repository events, en vez de depender solo de sync manual/cron.
# GITHUB_WEBHOOK_SECRET: usado para verificar la firma HMAC de cada
# webhook (generar con: openssl rand -hex 32) y como secreto configurado
# en cada webhook que se registra.
# WEBHOOK_BASE_URL: URL pública de esta app (sin barra final), usada para
# construir la URL de callback al registrar un webhook por repo
# (best-effort — requiere que el token tenga el scope admin:repo_hook o
# repo; sin él, el registro simplemente no ocurre y el cron de
# reconciliación diario sigue cubriendo la sincronización igual).
GITHUB_WEBHOOK_SECRET=""
WEBHOOK_BASE_URL="http://localhost:3000"

# Notificaciones por email (Fase 8) - https://www.mailgun.com
# Opcional, igual que HUGGINGFACE_API_KEY: sin esta config completa, el
# envío de emails cae a un no-op documentado (ver lib/notifications/email.ts)
# y el resto del pipeline (Wrapped generado, badges otorgados) no se ve
# afectado — las notificaciones son un aviso encima de datos que ya
# existen, nunca un requisito para que existan.
MAILGUN_API_KEY=""
# Dominio verificado en Mailgun (Settings → Sending → Domains), ej: mg.tudominio.com
MAILGUN_DOMAIN=""
# Dirección "from", ej: "GitHub Wrapped <wrapped@mg.tudominio.com>"
MAILGUN_FROM_EMAIL=""
# Solo si tu cuenta de Mailgun está en la región EU (por defecto usa
# api.mailgun.net; cuentas EU deben usar api.eu.mailgun.net)
MAILGUN_BASE_URL=""

# Tests E2E (Fase 12) - solo se usan al correr `npm run test:e2e`, nunca
# en el runtime normal de la app.
# URL base contra la que corre Playwright: un preview deploy de Vercel,
# staging, o localhost:3000 en CI. NUNCA apuntar esto a producción --
# e2e/seed.ts crea y borra un usuario de prueba real en la DB que esté
# detrás de esta URL.
E2E_BASE_URL="http://localhost:3000"
# Playwright necesita descargar binarios de navegador la primera vez:
# `npx playwright install chromium firefox webkit`. Requiere acceso de
# red a cdn.playwright.dev (bloqueado en este sandbox de desarrollo, ver
# README.md, Fase 12).

# CI/CD (Fase 13) - no hace falta configurar nada acá para levantar el
# pipeline: .github/workflows/ci.yml define sus propios valores dummy
# para build/typecheck, un servicio de Postgres efímero y el Inngest Dev
# Server para el job de E2E. INNGEST_DEV=1 (ver ese workflow) es lo que
# hace que `inngest.send(...)` hable con el Dev Server local en vez de
# con Inngest Cloud durante los tests -- no es necesario en desarrollo
# local normal si ya estás corriendo `npx inngest-cli@latest dev` como
# describe la sección Setup de este README.
