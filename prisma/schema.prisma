// GitHub Wrapped — Prisma schema
// Ver ROADMAP.md secciones 9 y 35 para el razonamiento detrás de cada corrección.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// Auth.js (Prisma adapter) — modelos estándar obligatorios
// ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────
// Dominio de la aplicación
// ─────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  // name/email/emailVerified/image son los campos "estándar" que espera
  // @auth/prisma-adapter por defecto (ver lib/auth/index.ts). githubId y
  // username se rellenan aparte en el callback signIn a partir del profile
  // de GitHub, ya que son específicos de nuestro dominio.
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  githubId      String?  @unique
  username      String?  @unique
  avatar        String?
  // ⚠️ Corrección (sección 9/14.4): necesario para normalizar día/hora de
  // actividad a la hora local del usuario en vez de UTC. IANA tz name.
  timezone  String   @default("UTC")
  // ⚠️ Fase 9: idioma preferido explícito, closed set en código
  // (lib/i18n/locales.ts), no enum de Prisma — misma convención que
  // Badge.type/Insight.type: agregar un idioma nuevo no debería requerir
  // migración, solo agregar el diccionario y sumarlo a SUPPORTED_LOCALES.
  // Default "es" porque el producto nace en español (ver ROADMAP.md);
  // se sobreescribe una vez con el Accept-Language del primer visitante
  // anónimo (cookie NEXT_LOCALE, ver middleware.ts) y, para usuarios
  // logueados, se puede cambiar explícitamente desde /settings.
  locale    String   @default("es")
  // ⚠️ Fase 6: opt-in explícito para incluir repos privados en el
  // análisis. Por defecto false — el MVP es solo-públicos, y ampliar el
  // alcance requiere una decisión consciente del usuario, nunca un
  // default activado. `privateReposEnabledAt` es auditoría de cuándo se
  // activó por última vez (se limpia a null al desactivar, ver
  // lib/settings/service.ts).
  privateReposEnabled   Boolean   @default(false)
  privateReposEnabledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       Account[]
  sessions       Session[]
  githubAccount  GitHubAccount?
  repositories   Repository[]
  commits        Commit[]
  languageStats  LanguageStat[]
  wrappedReports WrappedReport[]
  insights       Insight[]
  syncState      SyncState?
  badges         Badge[]
  comparisonsInitiated ComparisonLink[] @relation("ComparisonRequester")
  comparisonsReceived  ComparisonLink[] @relation("ComparisonRecipient")
  notificationPreference NotificationPreference?
  notificationLogs       NotificationLog[]
  dataExportRequests     DataExportRequest[]
}

// GitHub App/OAuth token storage.
// ⚠️ accessToken / refreshToken deben cifrarse en la capa de aplicación
// (ver lib/github/crypto.ts) antes de persistirse. NUNCA texto plano ni en logs.
model GitHubAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  accessToken  String    @db.Text // cifrado en reposo
  refreshToken String?   @db.Text // cifrado en reposo
  scope        String?
  tokenType    String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Repository {
  id          String   @id @default(cuid())
  githubId    String   @unique
  name        String
  fullName    String
  description String?
  // MVP: solo se sincronizan repos con private = false (ver sección 5).
  // El campo se mantiene para cuando el opt-in de repos privados exista.
  private     Boolean  @default(false)
  url         String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // ⚠️ Fase 7: si el registro del webhook (push/repository) tuvo éxito
  // para este repo. Best-effort — requiere que el token tenga scope
  // admin:repo_hook (público) o repo (privado, ya cubierto en Fase 6);
  // nuestro scope base no lo incluye, así que esto queda en `false` para
  // la mayoría de los repos hasta que se resuelva el scope adicional o
  // se migre a GitHub App (ver lib/github/webhooks.ts). No bloquea nada
  // — el cron de reconciliación cubre estos repos igual.
  webhookRegistered Boolean @default(false)

  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commits Commit[]
  languageStats LanguageStat[]

  @@index([userId])
}

model Commit {
  id          String   @id @default(cuid())
  sha         String
  message     String   @db.Text
  date        DateTime // timestamp original en UTC, tal como lo entrega GitHub
  author      String
  // ⚠️ Corrección (sección 11): usada para resolver identidad contra los
  // emails verificados del usuario, no solo author.login.
  authorEmail String?

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, sha])
  @@index([userId, date])
}

// ⚠️ Corrección (sección 9/26): serie de tiempo, no snapshot único.
// Necesario para "Language Evolution" — comparar distribución en distintos momentos.
model LanguageStat {
  id         String   @id @default(cuid())
  language   String
  bytes      Int
  percentage Float
  capturedAt DateTime @default(now())

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, capturedAt])
  @@index([repositoryId, capturedAt])
}

model WrappedReport {
  id                String   @id @default(cuid())
  userId            String
  periodStart       DateTime
  periodEnd         DateTime
  totalCommits      Int
  totalRepositories Int
  topLanguage       String?
  topRepository     String?
  mostActiveDay     String?
  mostActiveHour    Int?
  longestStreak     Int
  isPublic          Boolean  @default(false)
  // Orden narrativo fijo de los slides (Fase 3): apertura → volumen →
  // ritmo → lenguajes → repos → racha → cierre. Se guarda como Json (no
  // hardcodeado en el frontend) para poder reordenar o A/B testear el
  // orden narrativo más adelante sin migrar datos existentes.
  slidesOrder       Json
  // Distinto de `createdAt`: `createdAt` es cuándo se creó la fila por
  // primera vez; `generatedAt` es cuándo se generó/regeneró el contenido
  // más reciente. Para un año cerrado ambos coinciden para siempre (nunca
  // se regenera); para el año en curso, `generatedAt` avanza cada vez que
  // se regenera bajo demanda.
  generatedAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Un usuario tiene a lo sumo un WrappedReport por período exacto — la
  // generación siempre hace upsert por esta clave, nunca inserta filas
  // duplicadas para el mismo año.
  @@unique([userId, periodStart, periodEnd])
  @@index([userId])
}

// Estado de sincronización — soporta Initial / Incremental sync (sección 12)
// sin re-descargar todo cada vez.
model SyncState {
  id            String    @id @default(cuid())
  userId        String    @unique
  status        SyncStatus @default(IDLE)
  progress      Int        @default(0) // 0-100, para el polling del frontend (sección 32)
  lastSyncedAt  DateTime?
  lastCursor    String?    // cursor GraphQL / paginación REST para incremental sync
  errorMessage  String?    @db.Text
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SyncStatus {
  IDLE
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

// ─────────────────────────────────────────────────────────
// Insights Engine (Fase 1 del roadmap de producto final)
// ─────────────────────────────────────────────────────────

// Un Insight es la salida del Insights Engine: un patrón detectado por el
// Analytics Engine (puramente numérico) ya redactado en lenguaje natural.
// ⚠️ No tiene FK a WrappedReport todavía — esa relación se agrega en la
// fase de Wrapped Experience, cuando WrappedReport empiece a generarse de
// verdad. Por ahora un Insight se identifica por usuario + período, lo
// cual es suficiente para dashboard y para que Wrapped los reutilice
// después por (userId, periodStart, periodEnd) en vez de duplicar lógica.
model Insight {
  id          String        @id @default(cuid())
  userId      String
  periodStart DateTime
  periodEnd   DateTime
  // Tipo de insight detectado (ver lib/insights/types.ts para el catálogo
  // cerrado — se guarda como String, no enum, para poder agregar tipos
  // nuevos sin migración, siempre que el código los reconozca).
  type        String
  // Usada para elegir qué insights mostrar primero (dashboard, Wrapped).
  priority    Int
  // Métricas estructuradas que originaron el insight — nunca se calculan
  // aquí, vienen ya calculadas del Analytics Engine (sección 13/16).
  data        Json
  // Texto final mostrado al usuario — de IA o de plantilla determinista.
  narrative   String        @db.Text
  source      InsightSource @default(TEMPLATE)
  createdAt   DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Un mismo tipo de insight no se duplica para el mismo usuario+período;
  // regenerar reemplaza (upsert), no acumula filas.
  @@unique([userId, periodStart, periodEnd, type])
  @@index([userId, periodStart, periodEnd])
}

enum InsightSource {
  TEMPLATE
  AI
}

// Auditoría de costo/uso de IA (sección 16: "controlar costo en llamadas a
// IA"). Independiente de Insight para poder loguear también llamadas que
// fallaron o cayeron a fallback, sin ensuciar el modelo de dominio.
//
// ⚠️ Fase 10: a propósito NO tiene `user User @relation(...)` — es un log
// de costo operativo interno (cuántos tokens gastamos, no contenido del
// usuario), y encadenarlo con `onDelete: Cascade` obligaría a mantener
// filas de auditoría de facturación atadas al ciclo de vida de una cuenta
// que puede borrarse. En cambio, `lib/account/delete.ts::deleteAccount`
// borra estas filas explícitamente ANTES de borrar el User (dentro de la
// misma transacción) — el efecto de borrado es el mismo, pero es una
// decisión explícita del código de negocio, no un cascade implícito del
// schema sobre una tabla que es de nosotros, no del usuario.
model AiUsageLog {
  id           String   @id @default(cuid())
  userId       String
  purpose      String   // "insight_narration", futuro: otros usos de IA
  model        String
  inputTokens  Int
  outputTokens Int
  succeeded    Boolean
  fallbackUsed Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────
// Gamificación & Comparaciones (Fase 5 del roadmap de producto final)
// ─────────────────────────────────────────────────────────

// Un logro/badge que el usuario ganó con sus propios datos. Semántica
// "earned once, kept forever" (sección 42, DoD de la Fase 5): una vez
// otorgado, nunca se revoca aunque la métrica que lo originó baje después
// (p. ej. una racha activa que se corta no le quita a nadie el badge de
// "racha de 7 días" que ya ganó). Por eso `@@unique([userId, type])` se
// usa con upsert de solo-creación (`update: {}`) — nunca se sobreescribe
// un badge ya otorgado.
model Badge {
  id       String   @id @default(cuid())
  userId   String
  // Tipo cerrado — ver lib/gamification/badges.ts::BADGE_TYPES. String,
  // no enum, por el mismo motivo que Insight.type: agregar un badge
  // nuevo no debería requerir una migración de DB.
  type     String
  earnedAt DateTime @default(now())
  // Snapshot del valor que disparó el badge (p. ej. { longestStreak: 12 }
  // para streak_7) — útil para mostrar "lo ganaste con una racha de 12
  // días", no solo "ganaste este badge".
  metadata Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

// Comparación opcional entre dos usuarios (sección 42, Consideraciones:
// "opt-in explícito por ambas partes, revocable, nunca se filtra a quien
// no participó"). userA = quien inició la invitación; userB = a quien se
// invitó. El estado ACCEPTED es el único que habilita ver la comparación
// — ni siquiera los propios participantes pueden verla en PENDING.
model ComparisonLink {
  id          String           @id @default(cuid())
  userAId     String
  userBId     String
  status      ComparisonStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  userA User @relation("ComparisonRequester", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("ComparisonRecipient", fields: [userBId], references: [id], onDelete: Cascade)

  // Un mismo par de usuarios tiene a lo sumo UN vínculo de comparación,
  // sin importar quién invitó a quién — lib/comparisons/service.ts busca
  // en ambas direcciones antes de crear uno nuevo.
  @@unique([userAId, userBId])
  @@index([userBId, status])
}

enum ComparisonStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ─────────────────────────────────────────────────────────
// Seguridad / Compliance (Fase 10 del roadmap de producto final)
// ─────────────────────────────────────────────────────────

// Rate limiting propio de la aplicación -- deliberadamente independiente
// de los rate limits de la API de GitHub (REST 5000/h, GraphQL por
// puntos) que ya maneja el Data Collector (ver ROADMAP.md,
// "Restricciones no negociables"): esto protege el COSTO Y CAPACIDAD DE
// NUESTRA PROPIA infraestructura (jobs de Inngest, llamadas a la API de
// Anthropic, cómputo de ImageResponse) contra un usuario autenticado que
// dispare de más, no contra que GitHub nos corte el acceso.
//
// `key` es la unidad atómica ("action:userId", p. ej. "sync:clx123") --
// una fila por combinación de acción + actor, no una tabla genérica de
// requests. `lib/ratelimit/index.ts` hace el chequeo+incremento en una
// sola sentencia SQL (`$queryRaw`, upsert atómico) en vez de
// leer-luego-escribir, mismo principio de "la DB es el árbitro" que
// `lib/notifications/service.ts::tryClaimNotification` -- dos requests
// concurrentes del mismo usuario nunca pueden colarse ambas por debajo
// del límite.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
}

// Exportar los datos propios es trabajo pesado (lee commits, potencialmente
// decenas de miles por usuario — ver ROADMAP.md sección 32) y por lo tanto
// NUNCA corre inline en un Route Handler, mismo principio no-negociable
// que ya rige sync y la generación del Wrapped. El Route Handler solo crea
// esta fila en QUEUED y encola el evento; `lib/jobs/account-export.ts`
// hace el trabajo real vía Inngest y deja acá el resultado.
//
// `data` guarda el export completo como JSON directamente en Postgres —
// no se agregó un servicio de blob storage (S3, etc.) para esto porque no
// está en el stack declarado (ROADMAP.md) y el volumen esperado (incluso
// para un power user de decenas de miles de commits) entra cómodo en el
// límite de ~1GB por valor JSONB de Postgres. Si el producto creciera lo
// suficiente para que esto deje de ser cierto, ese es el momento de sumar
// blob storage — no antes.
model DataExportRequest {
  id           String              @id @default(cuid())
  userId       String
  status       DataExportStatus    @default(QUEUED)
  data         Json?
  requestedAt  DateTime            @default(now())
  completedAt  DateTime?
  errorMessage String?             @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
}

enum DataExportStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

// ─────────────────────────────────────────────────────────
// Notificaciones (Fase 8 del roadmap de producto final)
// ─────────────────────────────────────────────────────────

// Preferencias granulares por usuario y por tipo de notificación
// (sección "Siguiente paso" del README de la Fase 7). Deliberadamente
// una fila por usuario con una columna booleana por tipo -- igual que
// el resto del dominio (Badge.type, Insight.type), NO se modela como un
// enum ni como un blob JSON de preferencias: cada tipo nuevo de
// notificación que el producto agregue requiere una migración explícita
// (columna nueva con su propio default), lo cual es intencional --
// nunca queremos que un tipo de notificación nuevo "aparezca" activado
// o desactivado por accidente vía un default de JSON.
//
// A diferencia de `privateReposEnabled` (default false -- expandir qué
// se lee es una decisión consciente del usuario), estos defaults son
// `true`: son notificaciones sobre el propio contenido ya generado del
// usuario (su Wrapped, sus rachas), no una expansión del alcance de
// datos leídos. El usuario puede desactivarlas en cualquier momento
// desde /settings.
model NotificationPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  wrappedReadyEmail    Boolean  @default(true)
  streakMilestoneEmail Boolean  @default(true)
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Auditoría + deduplicación de envíos (sección Consideraciones: un cron
// diario que revisa "¿ya cerró el año?" puede correr de nuevo sin que
// eso implique reenviar el mismo email; un reintento de Inngest tras un
// fallo transitorio tampoco debe duplicar el envío). `key` identifica de
// forma única QUÉ disparó la notificación dentro de su `type` (el año
// para wrapped_ready, el tipo de badge para streak_milestone) -- antes
// de enviar, `lib/notifications/service.ts` siempre revisa que no exista
// ya un log con este (userId, type, key).
model NotificationLog {
  id     String   @id @default(cuid())
  userId String
  type   String
  key    String
  sentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, key])
  @@index([userId, type])
}
